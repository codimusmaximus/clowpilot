OPENAI_API_KEY=sk-...
# Optional — defaults to openai:gpt-5.4
# OPENAI_MODEL=openai:gpt-5.4

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Optional — pin a specific model (any provider:model string). Without this,
# the agent auto-picks the first cheap/fast model whose key is set.
# LLM_MODEL=anthropic:claude-sonnet-4-6
