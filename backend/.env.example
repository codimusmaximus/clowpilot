OPENAI_API_KEY=sk-...
# Optional — defaults to openai:gpt-5.4
# OPENAI_MODEL=openai:gpt-5.4

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Optional — pin a specific model (any provider:model string). Without this,
# the agent auto-picks the first cheap/fast model whose key is set.
# LLM_MODEL=anthropic:claude-sonnet-4-6

# ── MCP servers ────────────────────────────────────────────────────────────
# Remote MCP servers surface as toggleable plugins. The built-in presets stay
# hidden/disabled until their URL + token are set here. You can also add custom
# servers at runtime via POST /api/mcp-servers.

# Fiken (Norwegian accounting) — point at your Fiken MCP endpoint + API token.
# FIKEN_MCP_URL=https://your-fiken-mcp.example.com/mcp
# FIKEN_API_TOKEN=

# ── Outlook (native plugin, Microsoft Graph) ───────────────────────────────
# Outlook is a built-in plugin that signs in via the device-code flow and
# auto-refreshes its token (no token pasting). One-time setup:
#   1. Microsoft Entra admin center → App registrations → New registration.
#      Supported account types: include personal Microsoft accounts if it's a
#      personal mailbox ("Accounts in any org directory and personal accounts").
#   2. Authentication → Advanced settings → "Allow public client flows" = Yes.
#   3. API permissions → Microsoft Graph → Delegated → add:
#      offline_access, User.Read, Mail.ReadWrite, Mail.Send, Calendars.ReadWrite
#   4. Copy the Application (client) ID into OUTLOOK_CLIENT_ID below, then
#      enable the Outlook plugin and click Connect.
# OUTLOOK_CLIENT_ID=
# Tenant: "common" (personal + work/school), "consumers" (personal only),
# "organizations", or a specific tenant id. Defaults to "common".
# OUTLOOK_TENANT=common
